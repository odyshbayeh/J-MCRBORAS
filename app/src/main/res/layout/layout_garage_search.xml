<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.textfield.TextInputLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/spacing_sm"
    android:hint="@string/garage_search_hint"
    app:boxCornerRadiusBottomEnd="@dimen/corner_card"
    app:boxCornerRadiusBottomStart="@dimen/corner_card"
    app:boxCornerRadiusTopEnd="@dimen/corner_card"
    app:boxCornerRadiusTopStart="@dimen/corner_card"
    app:endIconMode="clear_text"
    app:hintEnabled="false"
    app:startIconDrawable="@drawable/ic_search">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/inputSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/garage_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>
