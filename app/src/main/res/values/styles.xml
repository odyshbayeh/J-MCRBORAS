<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.AfterSales.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="strokeColor">@color/color_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.AfterSales.Card</item>
    </style>

    <style name="ShapeAppearance.AfterSales.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_card</item>
    </style>

    <style name="ShapeAppearance.AfterSales.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_image</item>
    </style>

    <style name="TextAppearance.AfterSales.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AfterSales.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AfterSales.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/color_on_surface</item>
    </style>

    <style name="TextAppearance.AfterSales.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/color_on_surface_variant</item>
    </style>

    <style name="Widget.AfterSales.StatusPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_status_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AfterSales.CountBadge" parent="Widget.AfterSales.StatusPill">
        <item name="android:textColor">@color/color_on_primary_container</item>
        <item name="android:backgroundTint">@color/color_primary_container</item>
    </style>
</resources>
